Package: lmsqreg
Version: 0.2.2
Title: LMS (Cole-Green 1992) Quantile Regression
Authors@R: c(
    person(given = "Vincent", family = "Carey",
        email = "stvjc@channing.harvard.edu", role = c("aut", "cre")),
    person(given = "Claude", family = "Sonnet",
        role = "eng", comment = "Anthropic AI assistant")
